<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      第十二轮启动体验（平台 API 36，不引入 core-splashscreen）：
      - windowSplashScreen* 为 Android 12+ 平台 SplashScreen 属性；
      - windowBackground 用品牌底色避免白闪；
      - 状态栏/导航栏透明，图标明暗由 FitPlanTheme 在 Compose 首帧接管。
    -->
    <style name="Theme.FitPlan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/fitplan_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/fitplan_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
